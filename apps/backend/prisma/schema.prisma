// Nivasa - Prisma Database Schema
// Database: PostgreSQL per ARCHITECTURE.md and DATA_MODEL.md

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  RESIDENT
  HELPDESK
  ACCOUNTS
  COMMITTEE
  GUARD
}

enum MembershipType {
  OWNER
  TENANT
  FAMILY
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  CANCELLED
}

enum LedgerEntryType {
  BILL
  PAYMENT
  LATE_FEE
  ADJUSTMENT
  REVERSAL
}

enum BankTransactionStatus {
  UNMATCHED
  SUGGESTED
  NEEDS_REVIEW
  MATCHED
  POSTED
  DUPLICATE
  REJECTED
}

enum ComplaintCategory {
  PLUMBING
  ELECTRICAL
  LIFT
  SECURITY
  CLEANING
  COMMON_AREA
  CLUBHOUSE
  OTHER
}

enum ComplaintUrgency {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum ComplaintStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  WAITING_FOR_RESIDENT
  RESOLVED
  CLOSED
  REOPENED
}

model User {
  id                String           @id @default(uuid())
  name              String
  phone             String           @unique
  role              Role             @default(RESIDENT)
  preferredLanguage String           @default("en")
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  flatMemberships   FlatMembership[]
  payments          Payment[]
  complaints        Complaint[]      @relation("ResidentComplaints")
  assignedComplaints Complaint[]     @relation("AssignedComplaints")
  auditLogs         AuditLog[]
  timelineEvents    ComplaintTimeline[]
  noticesCreated    Notice[]

  @@index([phone])
  @@index([role])
}

model OtpVerification {
  id          String    @id @default(uuid())
  phone       String
  codeHash    String
  attempts    Int       @default(0)
  isVerified  Boolean   @default(false)
  expiresAt   DateTime
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([phone])
  @@index([expiresAt])
}

model Flat {
  id              String           @id @default(uuid())
  flatNumber      String
  tower           String
  areaSqFt        Int
  maintenanceRate Int              @default(650) // Paise per sq ft (₹6.50 = 650 paise)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  memberships     FlatMembership[]
  invoices        Invoice[]
  ledgerEntries   LedgerEntry[]
  complaints      Complaint[]
  visitors        Visitor[]
  guestCodes      GuestCode[]
  amenityBookings AmenityBooking[]

  @@unique([tower, flatNumber])
  @@index([tower])
}

model FlatMembership {
  id             String         @id @default(uuid())
  userId         String
  flatId         String
  membershipType MembershipType @default(OWNER)
  validFrom      DateTime       @default(now())
  validUntil     DateTime?
  permissions    String?        // JSON or comma-separated permissions
  createdAt      DateTime       @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  flat           Flat           @relation(fields: [flatId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([flatId])
}

model Invoice {
  id               String          @id @default(uuid())
  flatId           String
  billingPeriod    String          // e.g. "2026-11"
  areaSqFt         Int
  ratePerSqFt      Int             // in paise
  baseAmountPaise  Int
  lateFeePaise     Int             @default(0)
  totalAmountPaise Int
  paidAmountPaise  Int             @default(0)
  dueDate          DateTime
  status           InvoiceStatus   @default(ISSUED)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  flat             Flat            @relation(fields: [flatId], references: [id], onDelete: Cascade)
  payments         Payment[]
  ledgerEntries    LedgerEntry[]
  reconciliationMatches ReconciliationMatch[]

  @@unique([flatId, billingPeriod])
  @@index([flatId])
  @@index([status])
  @@index([dueDate])
}

model Payment {
  id                String        @id @default(uuid())
  invoiceId         String
  residentId        String
  amountPaise       Int
  provider          String        @default("MOCK_PAYMENT")
  providerReference String
  idempotencyKey    String        @unique
  status            PaymentStatus @default(INITIATED)
  paidAt            DateTime?
  createdAt         DateTime      @default(now())

  invoice           Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  resident          User          @relation(fields: [residentId], references: [id], onDelete: Restrict)
  receipt           Receipt?
  ledgerEntries     LedgerEntry[]

  @@unique([provider, providerReference])
  @@index([invoiceId])
  @@index([residentId])
  @@index([status])
}

model Receipt {
  id            String   @id @default(uuid())
  paymentId     String   @unique
  receiptNumber String   @unique
  issuedAt      DateTime @default(now())
  amountPaise   Int

  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([receiptNumber])
}

model LedgerEntry {
  id          String          @id @default(uuid())
  flatId      String
  invoiceId   String?
  paymentId   String?
  entryType   LedgerEntryType
  amountPaise Int
  description String
  createdAt   DateTime        @default(now())

  flat        Flat            @relation(fields: [flatId], references: [id], onDelete: Cascade)
  invoice     Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payment     Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([flatId])
  @@index([entryType])
}

model BankImportBatch {
  id            String            @id @default(uuid())
  fileName      String
  fileHash      String            @unique
  importedBy    String
  importedAt    DateTime          @default(now())
  status        String            @default("COMPLETED")
  totalRows     Int
  processedRows Int

  transactions  BankTransaction[]

  @@index([fileHash])
}

model BankTransaction {
  id                  String                @id @default(uuid())
  batchId             String
  transactionDate     DateTime
  amountPaise         Int
  reference           String
  upiId               String?
  description         String?
  normalizedReference String
  normalizedUpiId     String?
  transactionHash     String                @unique
  status              BankTransactionStatus @default(UNMATCHED)
  createdAt           DateTime              @default(now())

  batch               BankImportBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  matches             ReconciliationMatch[]

  @@index([batchId])
  @@index([status])
  @@index([amountPaise])
  @@index([normalizedReference])
}

model ReconciliationMatch {
  id                  String          @id @default(uuid())
  bankTransactionId   String
  invoiceId           String
  flatId              String
  suggestedAmountPaise Int
  confidence          Float
  matchingReasons     String          // JSON array of strings
  reviewedBy          String?
  reviewedAt          DateTime?
  status              String          @default("SUGGESTED")
  createdAt           DateTime        @default(now())

  bankTransaction     BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)
  invoice             Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([bankTransactionId])
  @@index([invoiceId])
  @@index([flatId])
}

model Complaint {
  id          String            @id @default(uuid())
  residentId  String
  flatId      String
  title       String
  description String
  category    ComplaintCategory @default(OTHER)
  urgency     ComplaintUrgency  @default(NORMAL)
  status      ComplaintStatus   @default(NEW)
  assignedTo  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  resolvedAt  DateTime?
  reopenedAt  DateTime?

  resident    User              @relation("ResidentComplaints", fields: [residentId], references: [id], onDelete: Restrict)
  assignee    User?             @relation("AssignedComplaints", fields: [assignedTo], references: [id], onDelete: SetNull)
  flat        Flat              @relation(fields: [flatId], references: [id], onDelete: Cascade)

  timeline    ComplaintTimeline[]
  attachments ComplaintAttachment[]
  assignments ComplaintAssignment[]
  sourceDuplicates ComplaintDuplicateLink[] @relation("SourceComplaint")
  targetDuplicates ComplaintDuplicateLink[] @relation("TargetComplaint")

  @@index([residentId])
  @@index([flatId])
  @@index([category])
  @@index([status])
  @@index([urgency])
}

model ComplaintTimeline {
  id             String           @id @default(uuid())
  complaintId    String
  actorId        String?
  eventType      String
  previousStatus ComplaintStatus?
  newStatus      ComplaintStatus?
  message        String
  createdAt      DateTime         @default(now())

  complaint      Complaint        @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  actor          User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([complaintId])
}

model ComplaintAttachment {
  id          String    @id @default(uuid())
  complaintId String
  storageKey  String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime  @default(now())

  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
}

model ComplaintDuplicateLink {
  id                String    @id @default(uuid())
  sourceComplaintId String
  targetComplaintId String
  similarity        Float
  linkedBy          String
  linkedAt          DateTime  @default(now())

  sourceComplaint   Complaint @relation("SourceComplaint", fields: [sourceComplaintId], references: [id], onDelete: Cascade)
  targetComplaint   Complaint @relation("TargetComplaint", fields: [targetComplaintId], references: [id], onDelete: Cascade)

  @@index([sourceComplaintId])
  @@index([targetComplaintId])
}

model ComplaintAssignment {
  id          String    @id @default(uuid())
  complaintId String
  assignedTo  String
  assignedBy  String
  assignedAt  DateTime  @default(now())
  reason      String?

  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  entityType String
  entityId   String
  action     String
  metadata   String?  // JSON string
  createdAt  DateTime @default(now())

  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
}

model Visitor {
  id              String    @id @default(uuid())
  flatId          String
  residentId      String
  visitorName     String
  visitorPhotoKey String?
  purpose         String
  expectedAt      DateTime?
  arrivedAt       DateTime?
  departedAt      DateTime?
  approvalStatus  String    @default("PENDING")
  createdAt       DateTime  @default(now())

  flat            Flat      @relation(fields: [flatId], references: [id], onDelete: Cascade)

  @@index([flatId])
  @@index([createdAt])
}

model GuestCode {
  id         String    @id @default(uuid())
  flatId     String
  createdBy  String
  codeHash   String
  validFrom  DateTime  @default(now())
  validUntil DateTime
  usageLimit Int       @default(1)
  usageCount Int       @default(0)
  isActive   Boolean   @default(true)

  flat       Flat      @relation(fields: [flatId], references: [id], onDelete: Cascade)

  @@index([flatId])
  @@index([codeHash])
}

model Amenity {
  id          String           @id @default(uuid())
  name        String
  description String?
  rules       String?
  feePaise    Int              @default(0)
  isActive    Boolean          @default(true)

  bookings    AmenityBooking[]
}

model AmenityBooking {
  id         String   @id @default(uuid())
  amenityId  String
  flatId     String
  residentId String
  startAt    DateTime
  endAt      DateTime
  feePaise   Int      @default(0)
  status     String   @default("CONFIRMED")
  createdAt  DateTime @default(now())

  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  flat       Flat     @relation(fields: [flatId], references: [id], onDelete: Cascade)

  @@index([amenityId])
  @@index([flatId])
}

model Notice {
  id          String    @id @default(uuid())
  title       String
  body        String
  language    String    @default("en")
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?
  createdBy   String

  author      User      @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([publishedAt])
}

