# ==============================================================================
# Nivasa - Environment Configuration Example
# Copy this file to .env before starting the development environment.
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nivasa_dev?schema=public"

# Authentication & Security
JWT_SECRET="nivasa-super-secure-dev-jwt-secret-key-change-in-production-2026"
JWT_EXPIRES_IN="7d"

# Development OTP Configuration (Dev only - never in production)
DEV_OTP_ENABLED=true
DEV_OTP_DEFAULT_CODE="123456"

# Mock Payment Gateway Configuration
MOCK_PAYMENT_ENABLED=true
MOCK_PAYMENT_LATENCY_MS=600

# AI Classification Service
AI_PROVIDER=fallback
AI_FALLBACK_ENABLED=true
# Optional API Key if using live provider:
# GEMINI_API_KEY=""

# Storage / File Uploads
UPLOAD_DIR="./uploads"

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:4000/api/v1"

